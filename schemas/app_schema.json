{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BoxMux App Configuration Schema",
  "description": "JSON Schema for validating BoxMux YAML application configurations",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "layouts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/layout"
          },
          "minItems": 1,
          "description": "Array of layout definitions"
        },
        "libs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional array of external script library files to include"
        },
        "on_keypress": {
          "$ref": "#/definitions/key_bindings"
        },
        "hot_keys": {
          "type": "object",
          "patternProperties": {
            "^.+$": {
              "type": "string"
            }
          },
          "description": "Global hot key shortcuts mapping keys to choice IDs for direct execution"
        },
        "variables": {
          "$ref": "#/definitions/variables"
        },
        "shell": {
          "type": "string",
          "enum": [
            "bash",
            "sh",
            "zsh",
            "powershell",
            "pwsh"
          ],
          "description": "The shell scripts run in (default: bash, or powershell on Windows)"
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Path of the plugin library; a relative path is relative to this file"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "description": "Plugin libraries that draw boxes with a plugin_component"
        }
      },
      "required": [
        "layouts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "app"
  ],
  "additionalProperties": false,
  "definitions": {
    "color_name": {
      "type": "string",
      "enum": [
        "default",
        "black",
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan",
        "white",
        "bright_black",
        "bright_red",
        "bright_green",
        "bright_yellow",
        "bright_blue",
        "bright_magenta",
        "bright_cyan",
        "bright_white"
      ],
      "description": "A terminal color: one of the 16 ANSI colors, or default for the terminal default color"
    },
    "anchor_type": {
      "type": "string",
      "enum": [
        "TopLeft",
        "TopRight",
        "BottomLeft",
        "BottomRight",
        "Center",
        "CenterTop",
        "CenterBottom",
        "CenterLeft",
        "CenterRight"
      ],
      "default": "Center"
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "Immediate",
        "Thread",
        "Pty"
      ],
      "default": "Immediate",
      "description": "Execution mode for script/choice - Immediate (synchronous), Thread (background), or Pty (real-time terminal)"
    },
    "position_value": {
      "type": "string",
      "pattern": "^((100(\\.0{1,2})?|[1-9]?[0-9](\\.[0-9]{1,2})?)%|[0-9]+)$",
      "description": "A percentage of the enclosing box or screen with up to two decimals (0% is the first cell, 100% the last), or a number of cells"
    },
    "overflow_behavior": {
      "type": "string",
      "enum": [
        "scroll",
        "wrap",
        "truncate"
      ],
      "description": "What happens to content larger than the box: scroll shows scrollbars, wrap breaks long lines, truncate cuts it off"
    },
    "title_position": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "input_bounds": {
      "type": "object",
      "properties": {
        "x1": {
          "$ref": "#/definitions/position_value",
          "description": "Left position"
        },
        "y1": {
          "$ref": "#/definitions/position_value",
          "description": "Top position"
        },
        "x2": {
          "$ref": "#/definitions/position_value",
          "description": "Right position"
        },
        "y2": {
          "$ref": "#/definitions/position_value",
          "description": "Bottom position"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for the choice"
        },
        "content": {
          "type": "string",
          "description": "Display text for the choice"
        },
        "script": {
          "$ref": "#/definitions/script"
        },
        "copy": {
          "oneOf": [
            {
              "const": true
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "description": "Activating the choice copies text to the clipboard (OSC 52) instead of running a script: true copies the label as shown, a string copies that string exactly"
        },
        "execution_mode": {
          "$ref": "#/definitions/execution_mode",
          "description": "Execution mode for choice script"
        },
        "redirect_output": {
          "type": "string",
          "description": "ID of box to redirect choice output to"
        },
        "append_output": {
          "type": "boolean",
          "description": "Whether to append choice output or replace"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "box": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for the box"
        },
        "title": {
          "type": "string",
          "description": "Optional display title for the box"
        },
        "position": {
          "$ref": "#/definitions/input_bounds",
          "description": "MuxBox position and size bounds"
        },
        "anchor": {
          "$ref": "#/definitions/anchor_type",
          "description": "Anchor point for box positioning"
        },
        "min_width": {
          "type": "integer",
          "minimum": 1
        },
        "min_height": {
          "type": "integer",
          "minimum": 1
        },
        "max_width": {
          "type": "integer",
          "minimum": 1
        },
        "max_height": {
          "type": "integer",
          "minimum": 1
        },
        "overflow_behavior": {
          "$ref": "#/definitions/overflow_behavior",
          "description": "How to handle content overflow"
        },
        "refresh_interval": {
          "type": "integer",
          "minimum": 1,
          "description": "Milliseconds between runs of the script"
        },
        "tab_order": {
          "type": "integer",
          "minimum": 0,
          "description": "Position in keyboard focus order (Tab); boxes without one are not focused with Tab"
        },
        "next_focus_id": {
          "type": "string",
          "description": "ID of next box to focus when tabbing"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/box"
          },
          "description": "Array of nested child boxes"
        },
        "fill": {
          "type": "boolean",
          "description": "Whether to fill box background"
        },
        "fill_char": {
          "$ref": "#/definitions/fill_char"
        },
        "selected_fill_char": {
          "$ref": "#/definitions/fill_char"
        },
        "border_color": {
          "$ref": "#/definitions/color_name",
          "description": "Border color"
        },
        "selected_border_color": {
          "$ref": "#/definitions/color_name",
          "description": "Border color when selected"
        },
        "bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Background color"
        },
        "selected_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Background color when selected"
        },
        "fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Foreground/text color"
        },
        "selected_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Foreground color when selected"
        },
        "title_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title text color"
        },
        "title_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title background color"
        },
        "selected_title_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title background color when selected"
        },
        "selected_title_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title text color when selected"
        },
        "title_position": {
          "$ref": "#/definitions/title_position",
          "description": "Horizontal alignment of title"
        },
        "error_border_color": {
          "$ref": "#/definitions/color_name",
          "description": "Border color in error state"
        },
        "error_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Background color in error state"
        },
        "error_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Text color in error state"
        },
        "error_title_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title background color in error state"
        },
        "error_title_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title text color in error state"
        },
        "error_selected_border_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected border color in error state"
        },
        "error_selected_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected background color in error state"
        },
        "error_selected_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected text color in error state"
        },
        "error_selected_title_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected title background color in error state"
        },
        "error_selected_title_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected title text color in error state"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/choice"
          },
          "description": "Array of interactive menu choices"
        },
        "menu_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Menu text color"
        },
        "menu_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Menu background color"
        },
        "selected_menu_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected menu text color"
        },
        "selected_menu_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected menu background color"
        },
        "highlighted_menu_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Menu text color when highlighted/hovered"
        },
        "highlighted_menu_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Menu background color when highlighted/hovered"
        },
        "highlighted_border_color": {
          "$ref": "#/definitions/color_name",
          "description": "Border color when highlighted/hovered"
        },
        "highlighted_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Background color when highlighted/hovered"
        },
        "highlighted_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Foreground color when highlighted/hovered"
        },
        "highlighted_title_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title background color when highlighted/hovered"
        },
        "highlighted_title_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title text color when highlighted/hovered"
        },
        "highlighted_fill_char": {
          "$ref": "#/definitions/fill_char"
        },
        "redirect_output": {
          "type": "string",
          "description": "ID of box to redirect script output to"
        },
        "append_output": {
          "type": "boolean",
          "description": "Whether to append to existing content or replace"
        },
        "script": {
          "$ref": "#/definitions/script"
        },
        "execution_mode": {
          "$ref": "#/definitions/execution_mode",
          "description": "Execution mode for box script - immediate (synchronous), thread (background), or pty (real-time terminal)"
        },
        "on_keypress": {
          "$ref": "#/definitions/key_bindings"
        },
        "variables": {
          "$ref": "#/definitions/variables"
        },
        "horizontal_scroll": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Initial scroll position, in percent"
        },
        "vertical_scroll": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Initial scroll position, in percent"
        },
        "selected": {
          "type": "boolean",
          "description": "Whether box is currently selected"
        },
        "content": {
          "type": "string",
          "description": "Static text content to display in box"
        },
        "save_in_file": {
          "type": "string",
          "description": "File path to save box content to"
        },
        "chart_type": {
          "type": "string",
          "enum": [
            "bar",
            "line",
            "histogram",
            "pie",
            "scatter"
          ]
        },
        "chart_data": {
          "type": "string",
          "description": "Chart data in CSV format (label,value or label:value or label value)"
        },
        "plugin_component": {
          "type": "string",
          "description": "Plugin component type to render in this box"
        },
        "plugin_config": {
          "type": "object",
          "description": "Configuration passed to the plugin component as JSON",
          "additionalProperties": true
        },
        "table_data": {
          "type": "string",
          "description": "Table data in CSV or JSON format"
        },
        "table_config": {
          "type": "object",
          "properties": {
            "show_headers": {
              "type": "boolean",
              "description": "Show the header row (default: true)"
            },
            "sort_column": {
              "type": "string",
              "description": "Header of the column rows are sorted by"
            },
            "sort_ascending": {
              "type": "boolean",
              "description": "Sort ascending (default: true)"
            },
            "filters": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Only rows whose value in the named column equals the given text, ignoring case"
            },
            "border_style": {
              "type": "string",
              "enum": [
                "none",
                "single",
                "double",
                "rounded",
                "thick"
              ]
            },
            "zebra_striping": {
              "type": "boolean"
            },
            "max_column_width": {
              "type": "integer",
              "minimum": 1
            },
            "show_row_numbers": {
              "type": "boolean"
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "description": "Rows per page; the table is not paged without it"
            },
            "current_page": {
              "type": "integer",
              "minimum": 0
            },
            "show_page_info": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "description": "How the table is sorted, filtered, paged and drawn. The table data is table_data, or the output of the box's script"
        },
        "auto_scroll_bottom": {
          "type": "boolean",
          "description": "Automatically scroll to bottom when new content arrives"
        },
        "z_index": {
          "type": "integer",
          "description": "Layering priority - higher values appear on top when boxes overlap (default: 0)"
        }
      },
      "required": [
        "id",
        "position"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for the layout"
        },
        "title": {
          "type": "string",
          "description": "Optional display title for the layout"
        },
        "refresh_interval": {
          "type": "integer",
          "minimum": 1,
          "description": "Default refresh interval of the boxes in this layout, in milliseconds"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/box"
          },
          "description": "Array of child boxes within this layout"
        },
        "fill": {
          "type": "boolean",
          "description": "Whether to fill the layout background"
        },
        "fill_char": {
          "$ref": "#/definitions/fill_char"
        },
        "selected_fill_char": {
          "$ref": "#/definitions/fill_char"
        },
        "border_color": {
          "$ref": "#/definitions/color_name",
          "description": "Border color"
        },
        "selected_border_color": {
          "$ref": "#/definitions/color_name",
          "description": "Border color when selected"
        },
        "bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Background color"
        },
        "selected_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Background color when selected"
        },
        "fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Foreground/text color"
        },
        "selected_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Foreground color when selected"
        },
        "title_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title text color"
        },
        "title_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title background color"
        },
        "title_position": {
          "$ref": "#/definitions/title_position",
          "description": "Horizontal alignment of title"
        },
        "selected_title_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title background color when selected"
        },
        "selected_title_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title text color when selected"
        },
        "menu_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Menu text color"
        },
        "menu_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Menu background color"
        },
        "selected_menu_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected menu text color"
        },
        "selected_menu_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected menu background color"
        },
        "highlighted_menu_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Menu text color when highlighted/hovered"
        },
        "highlighted_menu_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Menu background color when highlighted/hovered"
        },
        "highlighted_border_color": {
          "$ref": "#/definitions/color_name",
          "description": "Border color when highlighted/hovered"
        },
        "highlighted_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Background color when highlighted/hovered"
        },
        "highlighted_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Foreground color when highlighted/hovered"
        },
        "highlighted_title_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title background color when highlighted/hovered"
        },
        "highlighted_title_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title text color when highlighted/hovered"
        },
        "highlighted_fill_char": {
          "$ref": "#/definitions/fill_char"
        },
        "error_border_color": {
          "$ref": "#/definitions/color_name",
          "description": "Border color in error state"
        },
        "error_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Background color in error state"
        },
        "error_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Text color in error state"
        },
        "error_title_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title background color in error state"
        },
        "error_title_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Title text color in error state"
        },
        "error_selected_border_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected border color in error state"
        },
        "error_selected_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected background color in error state"
        },
        "error_selected_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected text color in error state"
        },
        "error_selected_title_bg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected title background color in error state"
        },
        "error_selected_title_fg_color": {
          "$ref": "#/definitions/color_name",
          "description": "Selected title text color in error state"
        },
        "overflow_behavior": {
          "$ref": "#/definitions/overflow_behavior",
          "description": "How to handle content overflow"
        },
        "root": {
          "type": "boolean",
          "description": "Whether this is the root layout"
        },
        "on_keypress": {
          "$ref": "#/definitions/key_bindings"
        },
        "variables": {
          "$ref": "#/definitions/variables"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "variables": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Variables for ${NAME} substitution in string values"
    },
    "key_bindings": {
      "type": "object",
      "patternProperties": {
        "^.+$": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "description": "Commands to run when a key is pressed, by key name (e.g. \"Ctrl+r\", \"F5\", \"q\")"
    },
    "script": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "A script, run as one text (multi-line scripts keep their lines)"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "description": "A command YAML read as a mapping because it contains \": \" without quotes"
              }
            ]
          },
          "description": "Commands, one per element, run in order"
        }
      ]
    },
    "fill_char": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1
    }
  }
}
