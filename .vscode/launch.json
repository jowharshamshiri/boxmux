{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug boxmux on a layout",
            "cargo": {
                "args": ["build", "--bin=boxmux", "--package=boxmux"],
                "filter": { "name": "boxmux", "kind": "bin" }
            },
            "args": ["layouts/system_monitor_pro.yaml", "--log-file", "boxmux-debug.log", "--log-level", "debug"],
            // boxmux draws a full-screen interface, so it needs a real terminal.
            "terminal": "integrated",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug library tests",
            "cargo": {
                "args": ["test", "--no-run", "--lib", "--package=boxmux"],
                "filter": { "name": "boxmux_lib", "kind": "lib" }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug end-to-end tests",
            "cargo": {
                "args": ["test", "--no-run", "--test=live_ux", "--package=boxmux"],
                "filter": { "name": "live_ux", "kind": "test" }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
